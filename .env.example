# Copy this file to .env and fill in real values.
DRY_RUN=true
REQUIRE_CONFIRMATION=true
MAX_EMAILS_PER_CYCLE=5
LOOP_INTERVAL_SECONDS=300
RATE_LIMIT_ACTIONS_PER_MINUTE=10

OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

EMAIL_PROVIDER=gmail
EMAIL_ADDRESS=your.email@gmail.com
EMAIL_PASSWORD=your-app-password
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

FORWARD_TO_EMAIL=manager@example.com
NOTIFY_EMAIL=your.email@gmail.com
AUTO_REPLY_CATEGORIES=work,personal
FORWARD_CATEGORIES=urgent
SPAM_KEYWORDS=lottery,crypto giveaway,wire transfer,urgent inheritance

MEMORY_BACKEND=local
MEMORY_DIR=data/memory
DATABASE_PATH=data/email_agent.db
ATTACHMENT_DIR=data/attachments
LOG_FILE=logs/email_agent.log

DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
